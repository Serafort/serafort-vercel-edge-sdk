{
  "name": "@serafort/vercel-edge",
  "version": "0.1.0",
  "type": "module",
  "description": "Vercel Edge Middleware, fast Web Crypto JWT verification, and Geo-Tenant routing for Serafort IAM.",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "type-check": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@serafort/core": "link:../Javascript"
  },
  "peerDependencies": {
    "@vercel/edge": ">=1.1.0"
  },
  "peerDependenciesMeta": {
    "@vercel/edge": {
      "optional": true
    }
  },
  "devDependencies": {
    "@vercel/edge": "^1.1.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
